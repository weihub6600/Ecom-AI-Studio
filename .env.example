# Server
PORT=8787
REQUEST_TIMEOUT_MS=180000

# MySQL 9.0+
# V8 uses MySQL for accounts, sessions, credits, cards, usage records and generation history.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ecom_ai_studio
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10
# true: automatically create MYSQL_DATABASE when the account has permission.
MYSQL_AUTO_CREATE_DATABASE=true
# true: import legacy data/auth.json and data/history.json once. Source files are retained.
MYSQL_MIGRATE_JSON=true
# Local MySQL normally uses false. Enable only when the server requires TLS.
MYSQL_SSL=false

# User authentication
# The account with this username becomes the site administrator.
# Register this exact username first after installation, or enter an existing username during installation.
ADMIN_USERNAME=admin
# Session validity: 30 days (seconds)
AUTH_SESSION_TTL_SECONDS=2592000
# Local HTTP development must stay false. Set true only after the production site uses HTTPS.
AUTH_COOKIE_SECURE=false

# Lingke AI / GPT Image 2
# Create an API key in the Lingke AI console, then copy this file to .env.
LINGKE_API_KEY=
LINGKE_BASE_URL=https://api.lk888.ai
LINGKE_IMAGE_ENDPOINT=/v1/media/generate
LINGKE_STATUS_ENDPOINT=/v1/media/status
LINGKE_IMAGE_MODEL=gpt-image-2

# GPT / GPT Image 2
GRSAI_API_KEY=
GRSAI_BASE_URL=https://grsai.dakka.com.cn
GRSAI_IMAGE_ENDPOINT=/v1/api/generate
GRSAI_DEFAULT_MODEL=gpt-image-2
GRSAI_TIMEOUT_MS=300000

# Generated image server storage
# Relative paths are resolved from the project root.
IMAGE_STORAGE_DIR=data
# 0 means permanently retain all server records and generated image files.
IMAGE_HISTORY_LIMIT=0
IMAGE_MAX_DOWNLOAD_BYTES=41943040
IMAGE_DOWNLOAD_TIMEOUT_MS=120000

# Nano Banana
# Can use its own Key; when empty, the backend reuses GRSAI_API_KEY.
NANO_BANANA_API_KEY=
NANO_BANANA_BASE_URL=https://grsai.dakka.com.cn
NANO_BANANA_IMAGE_ENDPOINT=/v1/api/generate
NANO_BANANA_IMAGE_SIZE=4K
NANO_BANANA_TIMEOUT_MS=300000
