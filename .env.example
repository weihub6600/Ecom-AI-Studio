# 服务端
PORT=8787
REQUEST_TIMEOUT_MS=180000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ecom_ai_studio
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=10
MYSQL_AUTO_CREATE_DATABASE=true
MYSQL_MIGRATE_JSON=true
MYSQL_SSL=false

# 用户登录
ADMIN_USERNAME=admin
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false

# V11 生图限流与并发保护
# 在指定时间窗口内，每个用户最多提交多少次生图请求
GENERATION_RATE_WINDOW_MS=60000
GENERATION_RATE_MAX_REQUESTS=8

# 全站同时调用模型接口的最大请求数
GENERATION_MAX_CONCURRENT=4

# 每个用户同时允许执行的生图请求数
GENERATION_MAX_PER_USER=1

# V11 健康检查磁盘预警阈值
HEALTH_DISK_WARNING_PERCENT=85
HEALTH_DISK_CRITICAL_PERCENT=95

# MySQL 备份保留天数
BACKUP_RETENTION_DAYS=14

# 百嘉瑞AI / GPT Image 2
LINGKE_API_KEY=
LINGKE_BASE_URL=https://api.lk888.ai
LINGKE_IMAGE_ENDPOINT=/v1/media/generate
LINGKE_STATUS_ENDPOINT=/v1/media/status
LINGKE_IMAGE_MODEL=gpt-image-2

# GPT / GPT Image 2
GRSAI_API_KEY=
GRSAI_BASE_URL=https://grsai.dakka.com.cn
GRSAI_IMAGE_ENDPOINT=/v1/api/generate
GRSAI_DEFAULT_MODEL=gpt-image-2
GRSAI_TIMEOUT_MS=300000

# 生成图片存储
IMAGE_STORAGE_DIR=data
IMAGE_HISTORY_LIMIT=0
IMAGE_MAX_DOWNLOAD_BYTES=41943040
IMAGE_DOWNLOAD_TIMEOUT_MS=120000

# 历史作品自动清理
# 默认关闭，避免未明确授权时永久删除用户作品。
HISTORY_RETENTION_ENABLED=false
# 仅当 HISTORY_RETENTION_ENABLED=true 时以下配置才生效。
HISTORY_MAX_IMAGES_PER_USER=20
HISTORY_MAX_AGE_DAYS=7
HISTORY_CLEANUP_INTERVAL_MS=60000

# Nano Banana
NANO_BANANA_API_KEY=
NANO_BANANA_BASE_URL=https://grsai.dakka.com.cn
NANO_BANANA_IMAGE_ENDPOINT=/v1/api/generate
NANO_BANANA_IMAGE_SIZE=4K
NANO_BANANA_TIMEOUT_MS=300000

# Task recovery
# Scan MySQL for interrupted generation tasks every 30 seconds.
GENERATION_RECOVERY_INTERVAL_MS=30000

# A synchronous task without a recoverable provider task id is treated as stale after 20 minutes.
GENERATION_SYNC_STALE_MS=1200000

# Lingke async tasks can be recovered for up to 24 hours.
GENERATION_ASYNC_MAX_AGE_MS=86400000

# Admin task console
# Active tasks that have not updated for 10 minutes are highlighted as potentially stuck.
GENERATION_ADMIN_STALE_MS=600000

# Server-side batch worker
BATCH_WORKER_INTERVAL_MS=2000
BATCH_INTERNAL_REQUEST_TIMEOUT_MS=360000

# V13.4.1 安全基线
# 生产环境请设置长度至少 32 位的随机字符串；留空时每次启动生成临时密钥。
CSRF_SECRET=
# 逗号分隔的额外可信前端 Origin，例如 https://studio.example.com
CSRF_TRUSTED_ORIGINS=

# 仅在明确知道反向代理层数或网段时配置。
# 示例：1 表示信任第一层反向代理；默认 false。
TRUST_PROXY=false

# 请求体分级限制
DEFAULT_JSON_LIMIT=1mb
BATCH_JSON_LIMIT=5mb
GENERATION_JSON_LIMIT=20mb

# 登录：IP 与账号分别累计失败次数
AUTH_LOGIN_IP_WINDOW_MS=900000
AUTH_LOGIN_IP_MAX_ATTEMPTS=5
AUTH_LOGIN_IP_BLOCK_MS=900000
AUTH_LOGIN_ACCOUNT_WINDOW_MS=900000
AUTH_LOGIN_ACCOUNT_MAX_ATTEMPTS=5
AUTH_LOGIN_ACCOUNT_BLOCK_MS=900000

# 注册：每个 IP 每小时最多 5 次
AUTH_REGISTER_IP_WINDOW_MS=3600000
AUTH_REGISTER_IP_MAX_ATTEMPTS=5
AUTH_REGISTER_IP_BLOCK_MS=3600000

# HSTS 仅在 HTTPS 且 AUTH_COOKIE_SECURE=true 时发送
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE_SECONDS=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false
SECURITY_EVENT_RETENTION_DAYS=90

# Dynamic API providers
# 必须单独生成至少 32 位随机字符串，不要与 CSRF_SECRET 共用。
# 生产环境不要使用示例值、change-me、default 等固定字符串。
API_PROVIDER_SECRET=
CUSTOM_PROVIDER_TIMEOUT_MS=300000
